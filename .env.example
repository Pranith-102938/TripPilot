# TripPilot Phase 4 Environment Configuration
# Copy this file to .env and configure for your local or production environment.

# Strands Decider 2B Model Configuration
# Official Hugging Face model identifier: StrandsAgents/strands-decider-2B (or StrandsAgents/strands-decider-2B-hobson-v21)
STRANDS_DECIDER_MODEL=StrandsAgents/strands-decider-2B

# Strands Decider Inference Endpoint
# When running strands-decider serve locally or on a remote GPU/SageMaker/Bedrock instance:
# Example: strands-decider serve StrandsAgents/strands-decider-2B --port 8001
STRANDS_DECIDER_ENDPOINT=http://127.0.0.1:8001/v1/systemone

# Optional API key for authenticating with protected Strands Decider inference endpoints
STRANDS_DECIDER_API_KEY=

# Local inference device when loading model weights in-process ('cpu' or 'cuda')
STRANDS_DECIDER_DEVICE=cpu

# Optional local checkpoint directory (if weights are downloaded locally)
STRANDS_DECIDER_LOCAL_CHECKPOINT=

# =====================================================================
# Amazon Bedrock Runtime Configuration
# =====================================================================
# AWS Region hosting your Amazon Bedrock model access (e.g., ap-southeast-2, us-east-1)
AWS_REGION=ap-southeast-2

# Amazon Bedrock Model or Inference Profile Identifier
# NOTE: For regions like ap-southeast-2 (Sydney), Bedrock requires a cross-region
# inference profile ID (or application inference profile ARN) rather than a bare model ID.
# This value is configurable and subject to confirmation against the active inference
# profiles available in your AWS account (e.g., au.anthropic.claude-sonnet-4-6,
# apac.anthropic.claude-3-5-sonnet-20241022-v2:0, or your custom profile ARN).
BEDROCK_MODEL_ID=au.anthropic.claude-sonnet-4-6

# AWS Authentication Guidance:
# BedrockService uses standard botocore credential resolution order:
# 1. Environment variables (set below for local testing, or leave empty if using IAM role/profile)
# 2. Local AWS credentials file (~/.aws/credentials) configured via `aws configure`
# 3. IAM role attached to EC2 / ECS / SageMaker / Lambda instance
#
# Standard AWS SDK environment variables (leave empty if using ~/.aws or IAM roles):
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

